{
  "name": "oszuidwest/streekomroep",
  "description": "Streekomroep theme to use with Timber",
  "license": "MPL-2.0",
  "type": "wordpress-theme",
  "minimum-stability": "stable",
  "authors": [
    {
      "email": "info@zuidwesttv.nl",
      "name": "Omroepstichting ZuidWest"
    }
  ],
  "scripts": {
    "test": [
      "@test:templates",
      "@test:responsive-images",
      "@test:search",
      "@test:collapsible",
      "@test:wordpress-toolbar",
      "@test:fm-live"
    ],
    "lint:twig": "twig-cs-fixer lint",
    "fix:twig": "twig-cs-fixer lint --fix",
    "test:search": "php tests/search-deduplication.php",
    "test:templates": "php tests/template-escaping.php",
    "test:responsive-images": "php tests/responsive-images.php",
    "test:collapsible": "php tests/collapsible.php",
    "test:wordpress-toolbar": "sh tests/wordpress-toolbar-contract.sh",
    "test:fm-live": "node --test tests/fm-live-player.mjs"
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://wpackagist.org"
    }
  ],
  "autoload": {
    "psr-4": {
      "Streekomroep\\": "src/"
    }
  },
  "autoload-dev": {
    "classmap": [
      "vendor/roots/wordpress-no-content/wp-includes/html-api/",
      "vendor/roots/wordpress-no-content/wp-includes/class-wp-token-map.php"
    ]
  },
  "require": {
    "php": ">=8.4",
    "ext-dom": "*",
    "ext-fileinfo": "*",
    "ext-json": "*",
    "league/commonmark": "^2.4",
    "nesbot/carbon": "^3.11",
    "symfony/yaml": "^8.0",
    "timber/timber": "~2.5.1",
    "twig/markdown-extra": "^3.7"
  },
  "replace": {
    "symfony/polyfill-php80": "*"
  },
  "require-dev": {
    "phpcompatibility/php-compatibility": "^10.0@alpha",
    "phpcompatibility/phpcompatibility-paragonie": "^2.0@alpha",
    "phpcompatibility/phpcompatibility-wp": "^3.0@alpha",
    "roots/wordpress-no-content": "~7.1.0",
    "vincentlanglet/twig-cs-fixer": "^4.0",
    "wp-coding-standards/wpcs": "^3.0"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "8.4"
    }
  }
}
