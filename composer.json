{
  "name": "oszuidwest/streekomroep",
  "description": "Streekomroep theme to use with Timber",
  "license": "MPL-2.0",
  "type": "wordpress-theme",
  "minimum-stability": "stable",
  "authors": [
    {
      "email": "info@zuidwesttv.nl",
      "name": "Omroepstichting ZuidWest"
    }
  ],
  "scripts": {
    "test": [
      "@test:templates",
      "@test:search",
      "@test:uitklap"
    ],
    "lint:twig": "twig-cs-fixer lint",
    "fix:twig": "twig-cs-fixer lint --fix",
    "test:search": "php tests/search-deduplication.php",
    "test:templates": "php tests/template-escaping.php",
    "test:uitklap": "php tests/uitklap-feed.php"
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://wpackagist.org"
    }
  ],
  "autoload": {
    "psr-4": {
      "Streekomroep\\": "src/"
    }
  },
  "require": {
    "ext-dom": "*",
    "ext-fileinfo": "*",
    "ext-json": "*",
    "php": ">=8.3",
    "league/commonmark": "^2.4",
    "nesbot/carbon": "^3.11",
    "symfony/yaml": "^7.4",
    "timber/timber": "~2.5.1",
    "twig/markdown-extra": "^3.7"
  },
  "require-dev": {
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "vincentlanglet/twig-cs-fixer": "^4.0",
    "wp-coding-standards/wpcs": "^3.0"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "8.3"
    }
  }
}
