{% import 'partial/responsive-image.twig' as responsive %}

<div class="bg-gray-800 text-white dark:border-t dark:border-gray-700/50">
    <div class="w-full mx-auto max-w-960 py-4 px-4">
        <div class="flex items-baseline justify-between gap-4 pb-4">
            {% if block.tekst_boven_videos %}
                <h2 class="font-bold text-3xl">{{ block.tekst_boven_videos }}</h2>
            {% endif %}
            <a href="{{ function('get_post_type_archive_link', 'tv') }}"
               class="ml-auto shrink-0 inline-flex items-center gap-0.5 text-sm font-bold text-blauw hover:text-white transition">
                <span>Alle programma's</span>
                <span class="shrink-0 size-4 [&>svg]:size-full" aria-hidden="true">{{ icon('icon-chevron_right') }}</span>
            </a>
        </div>

        <div class="grid sm:grid-cols-2 gap-4">
            {% for item in block.videos %}
                <a href="{{ item.show.link }}?v={{ item.video.id }}" class="grid sm:block md:grid grid-cols-2 gap-4 hover:bg-gray-700">
                    {{ responsive.render(
                        src: item.video.thumbnail,
                        width: 330,
                        height: 168,
                        sizes: '(min-width: 960px) 220px, (min-width: 768px) calc((100vw - 5rem) / 4), calc((100vw - 3rem) / 2)',
                        alt: item.show.title ~ ' - ' ~ item.video.name,
                        class: 'w-full',
                    ) }}
                    <div class="sm:mt-4 md:m-0">
                        <h3 class="font-bold">{{ item.show.title }}</h3>
                        <p>{{ item.video.name }}</p>
                    </div>
                </a>
            {% endfor %}
        </div>

        {% if block.shows is not empty %}
            <p class="text-sm tracking-wide uppercase font-bold font-round text-gray-400 mt-4">Of kijk een nieuwe aflevering van:</p>
            <ul class="flex flex-wrap gap-2 mt-2 items-center">
                {% for item in block.shows %}
                    <li>
                        <a href="{{ item.show.link }}"
                           class="block py-1 px-2 rounded-sm text-sm bg-gray-700 text-gray-100 hover:bg-gray-600 transition">{{ item.show.title }}</a>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>
</div>
