{% import 'partial/responsive-image.twig' as responsive %}

<div class="bg-gray-800 text-white dark:border-t dark:border-gray-700/50">
    <div class="w-full mx-auto max-w-960 py-4 px-4">
        {% if block.tekst_boven_videos %}
            <h2 class="font-bold text-3xl pb-4">{{ block.tekst_boven_videos }}</h2>
        {% endif %}

        <div class="grid sm:grid-cols-2 gap-x-4 gap-y-5">
            {% for item in block.videos %}
                <a href="{{ item.show.link }}?v={{ item.video.id }}"
                   class="group grid sm:block md:grid grid-cols-2 gap-4 rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-blauw">
                    <div class="overflow-hidden rounded-sm bg-gray-900">
                        {{ responsive.render(
                            src: item.video.thumbnail,
                            width: 330,
                            height: 168,
                            sizes: '(min-width: 960px) 220px, (min-width: 768px) calc((100vw - 5rem) / 4), calc((100vw - 3rem) / 2)',
                            alt: item.show.title ~ ' - ' ~ item.video.name,
                            class: 'w-full transition duration-300 ease-out group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100',
                        ) }}
                    </div>
                    <div class="self-center sm:mt-2 md:m-0">
                        <h3 class="font-bold leading-snug transition group-hover:text-blauw">{{ item.show.title }}</h3>
                        <p class="mt-0.5 text-sm text-gray-300">{{ item.video.name }}</p>
                    </div>
                </a>
            {% endfor %}
        </div>

        <p class="mt-6 text-xs tracking-wider uppercase font-bold font-round text-gray-400">Meer van ZuidWest TV</p>
        <ul class="flex flex-wrap gap-2 mt-2 items-center">
            {% for item in block.shows %}
                <li>
                    <a href="{{ item.show.link }}"
                       class="block py-1 px-2 rounded-sm text-sm border border-gray-600 text-gray-300 hover:border-gray-400 hover:text-white transition">{{ item.show.title }}</a>
                </li>
            {% endfor %}
            <li>
                <a href="{{ function('get_post_type_archive_link', 'tv') }}"
                   class="inline-flex items-center gap-1 py-1 pl-2 pr-1.5 rounded-sm text-sm bg-blauw text-white hover:bg-blauw/80 transition">
                    <span>Alle programma's</span>
                    <span class="shrink-0 size-4 [&>svg]:size-full" aria-hidden="true">{{ icon('icon-chevron_right') }}</span>
                </a>
            </li>
        </ul>
    </div>
</div>
