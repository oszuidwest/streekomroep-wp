{% extends 'base.twig' %}

{% block content %}
    <div class="mx-auto max-w-960 px-4 pb-8 text-gray-900 dark:text-white">
        {% embed 'partial/tabs.twig' %}
            {% block title %}
                De programma's van
            {% endblock %}

            {% block content %}
                {{ _self.tab('ZuidWest TV', 'icon-tv', function('get_post_type_archive_link', 'tv')) }}
                {{ _self.tab_active('ZuidWest FM', 'icon-radio') }}
            {% endblock %}
        {% endembed %}

        <div class="prose prose-lg mt-4 max-w-none text-center text-black dark:text-gray-200">
            <p>Bekijk alle informatie over onze programma's en luister uitzendingen terug.</p>
        </div>

        <div class="grid grid-cols-1 gap-4 py-8 sm:grid-cols-2 md:grid-cols-3">
            {% for post in posts %}
                {{ include('partial/tile-fm-show.twig', {
                    post: post,
                    schedule: fm_schedules[post.id],
                }) }}
            {% endfor %}
        </div>
    </div>
{% endblock %}
