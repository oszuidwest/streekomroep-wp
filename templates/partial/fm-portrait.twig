{# One presenter portrait. Rendered per maker and once, empty, into the template
   fm-live.js clones on schedule refresh, so the markup has a single definition. #}
<img {% if photo %}src="{{ function('esc_url', photo.src) }}" srcset="{{ photo.srcset|e('html_attr') }}"{% endif %}
     alt="{{ name|e('html_attr') }}" width="40" height="40" loading="lazy"
     class="size-8 rounded-sm object-cover object-[50%_16%] md:size-10">
