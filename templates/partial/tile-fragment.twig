<article data-post-id="{{ post.id }}">
    <a class="block" href="{{ post.link }}">
    {{ include('partial/post-thumbnail.twig', {post: post, sizes: sizes|default(null)}) }}
    <div class="pt-2">
        <div class="flex gap-2">
            {{ include('partial/tag-fragment-type.twig', {post: post}) }}
            {% if region ?? true %}
                {{ include('partial/tag-region.twig', {region: post.region, link: false}) }}
            {% endif %}
        </div>
        <h2 class="sm:text-xl font-semibold my-1 {% if dark ?? false %}text-white{% else %}text-black dark:text-white{% endif %}">{{ post.title }}</h2>
    </div>
</a>
</article>
