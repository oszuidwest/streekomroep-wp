{% import 'partial/responsive-image.twig' as responsive %}

{% set thumbnail = post.thumbnail %}
{% set width = width|default(228) %}
{% set sizes = sizes|default('(min-width: 768px) 220px, 50vw') %}
<div class="aspect-video relative rounded-sm overflow-hidden">
    <div class="{% if dark ?? false %}bg-gray-900{% else %}bg-gray-200{% endif %}">
        {% if thumbnail %}
            {{ responsive.render(
                src: thumbnail.src,
                width: width,
                height: width / 16 * 9,
                sizes: sizes,
                alt: thumbnail.alt|default(post.title),
                class: 'w-full h-full object-cover zw-thumb-hover',
            ) }}
        {% endif %}
        {{ include('partial/play-button.twig') }}
    </div>
</div>
