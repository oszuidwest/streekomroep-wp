{% set authors = post.authors|filter(author => author) %}
{% set avatars = [] %}
{% for author in authors %}
    {% set avatar = author.avatar ?: (author.user_email ? function('get_avatar_url', author.user_email, {size: 192}) : null) %}
    {% if avatar %}
        {% set avatars = avatars|merge([avatar]) %}
    {% endif %}
{% endfor %}

{% if authors %}
    <div class="flex items-center gap-5 {{ class|default('')|e('html_attr') }}">
        {% if avatars %}
            <span class="flex shrink-0 -space-x-10 sm:-space-x-12" aria-hidden="true">
                {% for avatar in avatars %}
                    <img src="{{ avatar|imgproxy(96, 96)|e('html_attr') }}"
                         srcset="{{ avatar|imgproxy(96 * 2, 96 * 2)|e('html_attr') }} 2x"
                         alt=""
                         class="relative h-20 w-20 rounded-sm object-cover object-[50%_16%] ring-2 ring-white transition-transform duration-200 first:z-10 hover:z-20 hover:-translate-y-1 sm:h-24 sm:w-24 dark:ring-gray-900">
                {% endfor %}
            </span>
        {% endif %}

        <span class="min-w-0 font-round text-xs leading-tight text-gray-500 sm:text-sm dark:text-gray-400">
            Geschreven door
            <span class="mt-1 block text-sm font-semibold text-black sm:text-base dark:text-white">
                {% for author in authors %}
                    <a href="{{ author.link|e('html_attr') }}" class="rounded-sm transition-colors duration-200 hover:text-roze focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-roze">{{ author.name|e }}</a>{% if not loop.last %}{% if loop.revindex == 2 %} &amp; {% else %}, {% endif %}{% endif %}
                {% endfor %}
            </span>
        </span>
    </div>
{% endif %}
