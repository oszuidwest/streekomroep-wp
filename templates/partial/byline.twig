{% set authors = post.authors|filter(author => author) %}

{% if authors %}
    {% set avatars = authors
        |map(author => author.avatar ?: (author.user_email ? function('get_avatar_url', author.user_email, {size: 64}) : null))
        |filter(avatar => avatar) %}

    <div class="flex flex-wrap items-center gap-3 {{ class|default('')|e('html_attr') }}">
        {% if avatars %}
            <span class="flex shrink-0 gap-1" aria-hidden="true">
                {% for avatar in avatars %}
                    <img src="{{ function('esc_url', avatar|imgproxy(32, 32)) }}"
                         srcset="{{ avatar|imgproxy(32 * 2, 32 * 2)|e('html_attr') }} 2x"
                         alt="" width="32" height="32" loading="lazy"
                         class="h-8 w-8 rounded-sm object-cover object-[50%_16%]">
                {% endfor %}
            </span>
        {% endif %}

        <span class="flex flex-wrap items-center gap-1 font-round text-xs font-black tracking-wide text-black uppercase dark:text-white">
            {% for author in authors %}
                <a href="{{ function('esc_url', author.link) }}" class="rounded-sm transition-colors duration-200 hover:text-roze focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-roze">{{ author.name|e }}</a>
                {% if not loop.last %}<span>{{ loop.revindex == 2 ? '&amp;' : ',' }}</span>{% endif %}
            {% endfor %}
        </span>
    </div>
{% endif %}
