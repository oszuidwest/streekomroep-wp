{% set maker_rows = post.meta('fm_show_makers')|rows %}
{% set makers = maker_rows|column('fm_show_maker_naam') %}
{% set portraits = maker_rows|slice(0, 3) %}

<a class="group flex h-full min-w-0 flex-col overflow-hidden rounded-sm border border-gray-800/10 bg-gray-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-roze dark:border-gray-200/10 dark:bg-gray-700/40"
   href="{{ function('esc_url', post.link) }}">
    <span class="relative block aspect-[2/1] flex-none overflow-hidden bg-gradient-to-br from-[#8f004e] to-roze sm:aspect-video">
        {{ include('partial/fm-header-pattern.twig', {compact: true}) }}
        {% if portraits is not empty %}
            <span class="absolute inset-0 flex items-center justify-center space-x-3 px-2 group-hover:space-x-4 group-focus-visible:space-x-4 [&>*]:transition-[margin] [&>*]:duration-300 [&>*]:ease-in-out motion-reduce:[&>*]:transition-none">
                {% for maker in portraits %}
                    {{ include('partial/fm-headshot.twig', {
                        image: maker.fm_show_maker_foto,
                        px: 80,
                        size_class: 'size-20',
                        surface_class: 'bg-white/20 text-white ring-4 ring-white/90 shadow-lg',
                    }) }}
                {% endfor %}
            </span>
        {% endif %}
    </span>

    <span class="flex flex-1 flex-col p-3 sm:p-4">
        <span class="block font-round text-lg leading-tight font-black text-gray-900 uppercase sm:text-xl dark:text-white">
            {{ post.title|plain|e }}
        </span>
        {% if makers is not empty %}
            <span class="mt-1 block text-sm leading-snug text-gray-500 dark:text-gray-400">
                Met {{ makers|join(', ', ' en ')|e }}
            </span>
        {% endif %}

        {% if post.schedule is not empty %}
            <span class="mt-3 block border-t border-gray-800/10 pt-3 font-round text-xs font-bold tracking-wide text-gray-500 uppercase sm:mt-4 dark:border-gray-200/10 dark:text-gray-400">
                {% for entry in post.schedule %}
                    <span class="block">{{ entry|format_schedule_compact|e }}</span>
                {% endfor %}
            </span>
        {% endif %}
    </span>
</a>
