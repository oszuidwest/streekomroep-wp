{# Collapsible background section rendered by the [uitklap] shortcode. #}
{% if collapsible %}
    <details class="zw-uitklap group my-6"{% if open %} open{% endif %}>
        <summary class="flex items-center gap-3 px-4 py-3 rounded-sm bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors cursor-pointer select-none font-bold text-lg leading-snug text-black dark:text-white">
            <span class="shrink-0 w-6 h-6 text-blauw" aria-hidden="true">
                <span class="group-open:hidden">{{ icon('icon-add') }}</span>
                <span class="hidden group-open:block">{{ icon('icon-remove') }}</span>
            </span>
            <span>{{ kop|e }}</span>
        </summary>
        <div class="zw-uitklap-body px-4">
            {{ content }}
        </div>
    </details>
{% else %}
    <h3>{{ kop|e }}</h3>
    {{ content }}
{% endif %}
