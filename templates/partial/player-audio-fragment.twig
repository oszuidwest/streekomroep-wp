{% set poster = poster_url|default(null) %}
{% if not poster and fragment.thumbnail %}
    {% set poster = fragment.thumbnail.src|imgproxy(1280, 720) %}
{% endif %}
<div class="aspect-video">
    <media-i18n>
        {% set poster = function('esc_url', poster|default('')) %}
        <video-player poster="{{ poster }}">
            <video-skin class="block size-full">
                {# Native controls keep it playable where Video.js does not run. #}
                <video src="{{ function('esc_url', fragment.meta('fragment_url', {format_value: false})|default('')) }}" poster="{{ poster }}" controls autoplay playsinline style="width: 100%; height: 100%;"></video>
            </video-skin>
        </video-player>
    </media-i18n>
</div>
