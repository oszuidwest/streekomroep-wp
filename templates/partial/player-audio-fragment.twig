{% set poster = poster_url|default(null) %}
{% if not poster and fragment.thumbnail %}
    {% set poster = fragment.thumbnail.src|imgproxy(1280, 720) %}
{% endif %}
<div class="aspect-video">
    <media-i18n>
        <video-player poster="{{ function('esc_url', poster|default('')) }}">
            <video-skin class="block size-full">
                <video src="{{ function('esc_url', fragment.meta('fragment_url', {format_value: false})|default('')) }}" autoplay playsinline></video>
            </video-skin>
        </video-player>
    </media-i18n>
</div>
