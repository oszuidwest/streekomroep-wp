{% set size_class = size_class|default('size-8 md:size-10') %}
{% set surface_class = surface_class|default('bg-roze text-white ring-2 ring-white/90') %}
{# Accepts a {src, srcset} map or an ACF image and target size. #}
{% set photo = photo|default(image ? {
    src: image|imgproxy(px, px),
    srcset: image|imgproxy(px * 2, px * 2) ~ ' 2x',
} : null) %}

<span class="grid {{ size_class }} flex-none place-items-center overflow-hidden rounded-sm {{ surface_class }}"
      aria-hidden="true">
    <img {% if photo %}src="{{ function('esc_url', photo.src) }}" srcset="{{ photo.srcset|e('html_attr') }}"{% endif %}
         alt="" width="128" height="128" loading="lazy"
         class="h-full w-full object-cover object-[50%_16%]" data-headshot-image
         {% if not photo %}hidden{% endif %}>
    <span class="grid h-full w-full place-items-center [&>svg]:size-1/2" data-headshot-placeholder {% if photo %}hidden{% endif %}>
        {{ icon('icon-headphones') }}
    </span>
</span>
