{% if pagination.pages is not empty %}
    {% set tile = 'h-12 flex items-center rounded-sm bg-gray-100 text-gray-900 hover:bg-gray-200 dark:bg-gray-700 dark:text-gray-100 dark:hover:bg-gray-600 transition-colors' %}
    {% set tile_disabled = 'h-12 flex items-center rounded-sm bg-gray-100 text-gray-400 dark:bg-gray-700 dark:text-gray-500' %}
    {% set chevron %}<span class="shrink-0 size-5 [&>svg]:size-full" aria-hidden="true">{{ icon('icon-chevron_right') }}</span>{% endset %}

    <nav aria-label="Paginering">
        <ul class="flex justify-center items-center gap-2 py-2 tabular-nums">

            <li class="flex-none">
                {% if pagination.prev %}
                    <a class="{{ tile }} gap-1 pl-2 pr-4" href="{{ pagination.prev.link }}"><span class="-scale-x-100">{{ chevron }}</span>Vorige</a>
                {% else %}
                    <button class="{{ tile_disabled }} gap-1 pl-2 pr-4" disabled><span class="-scale-x-100">{{ chevron }}</span>Vorige</button>
                {% endif %}
            </li>

            <li class="sm:hidden px-1 whitespace-nowrap text-sm text-gray-600 dark:text-gray-400">
                Pagina {{ pagination.current }} van {{ pagination.total }}
            </li>

            {% for page in pagination.pages %}
                <li class="hidden sm:block">
                    {% if page.link %}
                        <a class="{{ tile }} w-12 justify-center" href="{{ page.link }}">{{ page.title }}</a>
                    {% elseif page.current %}
                        <span aria-current="page" class="h-12 w-12 flex justify-center items-center rounded-sm bg-gray-800 text-white dark:bg-gray-200 dark:text-black {{ page.class }}">{{ page.title }}</span>
                    {% else %}
                        <span class="w-6 h-12 flex justify-center items-center text-gray-600 dark:text-gray-400">&hellip;</span>
                    {% endif %}
                </li>
            {% endfor %}

            <li class="flex-none">
                {% if pagination.next %}
                    <a class="{{ tile }} gap-1 pl-4 pr-2" href="{{ pagination.next.link }}">Volgende{{ chevron }}</a>
                {% else %}
                    <button class="{{ tile_disabled }} gap-1 pl-4 pr-2" disabled>Volgende{{ chevron }}</button>
                {% endif %}
            </li>
        </ul>
    </nav>
{% endif %}
