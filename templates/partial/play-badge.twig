{# Requires a positioned wrapper. #}
<div class="absolute bottom-2 right-2 transform-gpu inline-flex items-center gap-0.5 rounded-md bg-black/60 px-1 py-0.5 text-white">
    <span class="[&_svg]:size-4" aria-hidden="true">{{ icon('icon-play_arrow') }}</span>
    {% if duration %}
        <span class="pr-0.5 text-xs font-bold leading-none tabular-nums">{{ duration|format_duration }}</span>
    {% endif %}
</div>
