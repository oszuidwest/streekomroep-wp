{% extends 'base.twig' %}

{% set card = 'rounded-sm border border-gray-800/10 bg-gray-50 dark:border-gray-200/10 dark:bg-gray-700/40' %}
{% set muted = 'text-gray-500 dark:text-gray-400' %}
{% set radio_fallback_title = 'ZuidWest FM' %}
{% set radio_fallback_artist = 'In heel West-Brabant' %}

{% set has_stream = stream_sources is not empty %}
{% set current_makers = live_show ? live_show.meta('fm_show_makers')|rows : [] %}
{% set maker_names = current_makers|column('fm_show_maker_naam')|filter(name => name) %}
{% set on_air = current ? current.name : post.title %}

{% block content %}
    <article id="post-{{ post.id }}" class="{{ post.class }} pb-7 text-gray-900 lg:pb-9 dark:text-white"
             data-radio-live data-schedule-url="{{ broadcast_data_url }}"
             data-schedule-refresh-after="{{ schedule_refresh_after }}"
             data-metadata-url="{{ options.radio_live_metadata_url }}"
             data-radio-title="{{ radio_fallback_title }}">
        <header class="relative overflow-hidden bg-roze bg-gradient-to-r from-[#8f004e] via-[#c7006d] to-roze">
            {{ include('partial/fm-header-pattern.twig') }}
            <div class="relative mx-auto max-w-960 px-4 pt-6 pb-8 md:pt-7 md:pb-9">
                {{ include('partial/fm-breadcrumb.twig', {label: 'ZuidWest FM'}) }}

                <p class="mb-2 font-round text-sm font-extrabold tracking-wide text-white/90 uppercase"
                   data-current-status>
                    {% if live_show %}
                        Nu live · {{ current.start|date('H:i') }} – {{ current.end|date('H:i') }}
                    {% else %}
                        Nu op {{ radio_fallback_title }}
                    {% endif %}
                </p>

                <h1 class="font-round text-4xl leading-none font-black break-words text-white uppercase md:text-5xl"
                    data-current-title>{{ on_air }}</h1>

                <p class="mt-3 flex items-center gap-2.5 md:mt-3.5 md:gap-3" data-current-makers
                   {% if maker_names is empty %}hidden{% endif %}>
                    {% set portraits = current_makers|filter(maker => maker.fm_show_maker_foto)|slice(0, 2) %}
                    <span class="flex flex-none -space-x-1" data-current-portraits
                          {% if portraits is empty %}hidden{% endif %}>
                        {% for maker in portraits %}
                            {# Sized to match the REST payload, so a refresh reuses the cached image. #}
                            <img src="{{ maker.fm_show_maker_foto|imgproxy(44, 44) }}"
                                 srcset="{{ maker.fm_show_maker_foto|imgproxy(88, 88) }} 2x"
                                 alt="{{ maker.fm_show_maker_naam }}" width="40" height="40" loading="lazy"
                                 class="size-8 rounded-sm object-cover object-[50%_16%] md:size-10">
                        {% endfor %}
                    </span>
                    <span class="min-w-0 text-sm text-white/85 md:text-base">
                        Met <b class="font-semibold text-white" data-current-maker-names>{{ maker_names|join(', ', ' en ') }}</b>
                    </span>
                </p>

                <div class="mt-5 max-w-[26rem] md:max-w-[34rem]" data-progress
                     data-start="{{ live_show ? current.start.timestamp : 0 }}"
                     data-end="{{ live_show ? current.end.timestamp : 0 }}"
                     {% if not live_show %}hidden{% endif %}>
                    <div class="h-1.5 overflow-hidden rounded-sm bg-black/25">
                        <div class="h-full rounded-sm bg-white transition-[width] duration-500"
                             style="width: {{ progress|default(0) }}%" data-progress-bar></div>
                    </div>
                    <div class="mt-1.5 flex justify-between text-xs font-bold text-white/80 tabular-nums">
                        <span data-progress-start>{{ live_show ? current.start|date('H:i') : '' }}</span>
                        <span data-progress-label>{{ progress_label|default('') }}</span>
                        <span data-progress-end>{{ live_show ? current.end|date('H:i') : '' }}</span>
                    </div>
                </div>
            </div>
        </header>

        {% if has_stream %}
            {# Hidden on purpose: VideoJS drives the stream, the buttons in this page are the controls. #}
            <div class="hidden" aria-hidden="true">
                <audio id="zw-fm-stream" class="video-js" preload="none" playsinline>
                    {% for source in stream_sources %}
                        <source src="{{ source.url }}" type="{{ source.type }}">
                    {% endfor %}
                </audio>
            </div>
        {% endif %}

        <section class="mx-auto max-w-960 px-4 pt-7" aria-labelledby="live-player-title">
            <h2 id="live-player-title" class="mb-5 text-2xl font-bold md:text-3xl">{{ has_stream ? 'Luister live' : 'Nu op de radio' }}</h2>
            <div class="{{ card }} flex min-h-29 items-center gap-4 p-4 sm:gap-5 sm:p-5">
                {% if has_stream %}
                    <button type="button" aria-label="Luister live" data-play
                            class="grid size-18 flex-none touch-manipulation place-items-center rounded-sm bg-roze text-white shadow-[0_5px_14px_rgba(143,0,78,0.22)] transition hover:bg-[#8f004e] hover:shadow-[0_7px_18px_rgba(143,0,78,0.28)] active:translate-y-px focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-roze sm:size-22 motion-reduce:transition-none">
                        <span class="[&>svg]:size-9 sm:[&>svg]:size-11" data-play-icon="play">{{ icon('icon-play_arrow') }}</span>
                        <span class="[&>svg]:size-9 sm:[&>svg]:size-11" data-play-icon="pause" hidden>{{ icon('icon-pause') }}</span>
                    </button>
                {% endif %}
                <div class="min-w-0 flex-1" data-now-details aria-live="polite">
                    <p class="line-clamp-2 text-2xl leading-tight font-black sm:line-clamp-1 sm:text-3xl" data-now-title>
                        {{- has_stream ? radio_fallback_title : on_air -}}
                    </p>
                    <p class="mt-1 truncate text-sm sm:text-base {{ muted }}" data-now-artist>
                        {{- has_stream ? radio_fallback_artist : maker_names|join(', ', ' en ') -}}
                    </p>
                </div>
            </div>
        </section>

        <section class="mx-auto max-w-960 px-4 pt-7" data-upcoming
                 {% if upcoming is empty %}hidden{% endif %}>
            <h2 class="mb-5 text-2xl font-bold md:text-3xl">Straks</h2>
            <div class="grid gap-4 sm:grid-cols-2" data-upcoming-list>
                {% for item in upcoming %}
                    {% set makers = item.broadcast.show.meta('fm_show_makers')|rows %}
                    {{ include('partial/fm-upcoming-card.twig', {
                        href: item.broadcast.show.link,
                        time: item.broadcast.start|date('H:i'),
                        label: item.label,
                        title: item.broadcast.show.title,
                        names: makers|column('fm_show_maker_naam')|filter(name => name)|join(', ', ' en '),
                        photo: makers|column('fm_show_maker_foto')|filter(photo => photo)|first,
                    }) }}
                {% endfor %}
            </div>
        </section>

        <template data-upcoming-template>
            {{ include('partial/fm-upcoming-card.twig', {
                href: '', time: '', label: '', title: '', names: '', photo: null,
            }) }}
        </template>

        {% if frequency_groups is not empty %}
            <section class="mx-auto max-w-960 px-4 pt-7">
                <h2 class="text-2xl font-bold md:text-3xl">Waar je ons vindt</h2>
                <p class="mt-1 mb-5 text-sm {{ muted }}">Kies hoe je luistert en bekijk de juiste frequentie.</p>

                {% for group in frequency_groups %}
                    <details class="group {{ card }} {{ not loop.first ? 'mt-3 ' }}overflow-hidden">
                        <summary class="flex cursor-pointer list-none items-center gap-3 px-4 py-4 select-none focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-gray-800 dark:focus-visible:outline-gray-200 [&::-webkit-details-marker]:hidden">
                            <span class="min-w-14 rounded-sm bg-gray-800 px-2 py-1 text-center font-round text-xs font-extrabold tracking-wide text-white uppercase">{{ group.badge }}</span>
                            <span class="font-bold">{{ group.title }}</span>
                            <span class="ml-auto size-5 flex-none text-gray-400 transition-transform group-open:rotate-90 [&>svg]:size-full" aria-hidden="true">
                                {{ icon('icon-chevron_right') }}
                            </span>
                        </summary>
                        <div class="border-t border-gray-800/10 px-4 pt-3 pb-4 dark:border-gray-200/10">
                            <ul class="grid gap-3 sm:grid-cols-2">
                                {% for channel in group.channels %}
                                    <li class="rounded-sm bg-gray-100 px-3.5 py-3 dark:bg-gray-800">
                                        {% if channel.place %}
                                            <p class="text-sm leading-snug {{ muted }}">{{ channel.place }}</p>
                                        {% endif %}
                                        <p class="mt-0.5 text-3xl leading-none font-black tabular-nums">
                                            {{- channel.value -}}
                                            {%- if group.unit -%}
                                                <span class="ml-1 text-xs font-bold tracking-wider text-gray-400">{{ group.unit }}</span>
                                            {%- endif -%}
                                        </p>
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                    </details>
                {% endfor %}
            </section>
        {% endif %}
    </article>
{% endblock %}
