{% extends 'base.twig' %}

{% set card = 'rounded-sm border border-gray-800/10 bg-gray-50 dark:border-gray-200/10 dark:bg-gray-700/40' %}
{% set muted = 'text-gray-500 dark:text-gray-400' %}
{% set focus_ring_hero = 'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white' %}
{% set radio_fallback_title = 'ZuidWest FM' %}
{% set radio_fallback_artist = 'In heel West-Brabant' %}

{% set has_stream = stream_sources is not empty %}
{% set live_show = broadcast ? broadcast.show : null %}
{# Normalize the page title to the same plain-text contract as serialized broadcasts. #}
{% set on_air = broadcast ? broadcast.name : post.title|plain %}

{% block content %}
    <article id="post-{{ post.id }}" class="{{ post.class }} pb-7 text-gray-900 lg:pb-9 dark:text-white"
             data-radio-live data-schedule-url="{{ function('esc_url', broadcast_data_url) }}"
             data-schedule-refresh-after="{{ schedule_refresh_after }}"
             {# esc_url would strip the wss: scheme, so this attribute gets attribute escaping. #}
             data-metadata-url="{{ options.radio_live_metadata_url|e('html_attr') }}"
             data-radio-title="{{ radio_fallback_title }}"
             data-radio-tagline="{{ radio_fallback_artist }}"
             {% if media_artwork is not empty %}data-artwork="{{ media_artwork|json_encode|e('html_attr') }}"{% endif %}>
        <header class="relative overflow-hidden bg-roze bg-gradient-to-r from-[#8f004e] via-[#c7006d] to-roze">
            {{ include('partial/fm-header-pattern.twig') }}
            <div class="relative mx-auto max-w-960 px-4 pt-6 pb-8 md:pt-7 md:pb-9">
                {{ include('partial/fm-breadcrumb.twig', {label: 'ZuidWest FM'}) }}

                <p class="mb-2 font-round text-sm font-extrabold tracking-wide text-white/90 uppercase"
                   data-current-status>
                    {% if live_show %}
                        Nu live · {{ broadcast.start_time }} – {{ broadcast.end_time }}
                    {% else %}
                        Nu op {{ radio_fallback_title }}
                    {% endif %}
                </p>

                <h1 class="font-round text-4xl leading-none font-black break-words text-white uppercase md:text-5xl"
                    data-current-title>{{ on_air|e }}</h1>

                <p class="mt-3 flex items-center gap-2.5 md:mt-3.5 md:gap-3" data-current-makers
                   {% if live_show.makers_label is empty %}hidden{% endif %}>
                    {% set portraits = (live_show.makers ?? [])|slice(0, 2) %}
                    <span class="flex flex-none gap-1.5" data-current-portraits
                          {% if portraits is empty %}hidden{% endif %}>
                        {% for maker in portraits %}
                            {{ include('partial/fm-headshot.twig', {photo: maker.photo}) }}
                        {% endfor %}
                    </span>
                    <span class="min-w-0 text-sm text-white/85 md:text-base">
                        Met <b class="font-semibold text-white" data-current-maker-names>{{ live_show.makers_label|e }}</b>
                    </span>
                </p>

                <div class="mt-6 md:mt-7" data-progress
                     data-start="{{ live_show ? broadcast.start : 0 }}"
                     data-end="{{ live_show ? broadcast.end : 0 }}"
                     {% if not live_show %}hidden{% endif %}>
                    <div class="h-1.5 overflow-hidden rounded-sm bg-black/25">
                        <div class="h-full rounded-sm bg-white transition-[width] duration-500"
                             style="width: {{ progress|default(0) }}%" data-progress-bar></div>
                    </div>
                    <div class="mt-1.5 flex justify-between text-xs font-bold text-white/80 tabular-nums">
                        <span data-progress-start>{{ live_show ? broadcast.start_time : '' }}</span>
                        <span data-progress-label></span>
                        <span data-progress-end>{{ live_show ? broadcast.end_time : '' }}</span>
                    </div>
                </div>

                {% if has_stream %}
                    {# The player lives in the hero: what is on and the button to hear it are one thing. #}
                    <div class="mt-5 flex items-center gap-4 md:mt-6 md:gap-5">
                        <button type="button" aria-label="Luister live" data-play
                                class="grid size-16 flex-none touch-manipulation place-items-center rounded-sm bg-white text-roze transition hover:bg-white/90 {{ focus_ring_hero }} md:size-20 motion-reduce:transition-none">
                            <span class="[&>svg]:size-8 md:[&>svg]:size-10" data-play-icon="play">{{ icon('icon-play_arrow') }}</span>
                            <span class="[&>svg]:size-8 md:[&>svg]:size-10" data-play-icon="pause" hidden>{{ icon('icon-pause') }}</span>
                        </button>
                        <div class="min-w-0 flex-1" data-now-details aria-live="polite">
                            <p class="truncate text-lg leading-tight font-bold text-white md:text-xl" data-now-title>
                                {{- radio_fallback_title -}}
                            </p>
                            <p class="mt-0.5 truncate text-sm text-white/80" data-now-artist>
                                {{- radio_fallback_artist -}}
                            </p>
                        </div>
                        <div class="relative hidden flex-none md:block" data-volume-control>
                            <button type="button" aria-label="Volume aanpassen" aria-expanded="false"
                                    aria-controls="zw-fm-volume-panel" data-volume-toggle
                                    class="grid size-10 place-items-center rounded-sm text-white/80 transition hover:bg-white/15 hover:text-white {{ focus_ring_hero }} motion-reduce:transition-none">
                                <span class="[&>svg]:size-6" aria-hidden="true">{{ icon('icon-volume_up') }}</span>
                            </button>
                            <div id="zw-fm-volume-panel" class="absolute top-1/2 right-full z-10 mr-2 -translate-y-1/2 rounded-sm border border-gray-800/10 bg-white p-3 text-gray-900 shadow-lg"
                                 data-volume-panel hidden>
                                <div class="flex items-center gap-3">
                                    <label for="zw-fm-volume" class="sr-only">Volume</label>
                                    {# aria-valuetext carries the unit; the readout beside it is a visual mirror only. #}
                                    <input id="zw-fm-volume" type="range" min="0" max="100" step="1" value="100"
                                           class="h-2 w-28 cursor-pointer accent-roze lg:w-36" data-volume
                                           aria-valuetext="100%">
                                    <span class="w-10 text-right text-sm text-gray-500 tabular-nums"
                                          aria-hidden="true" data-volume-value>100%</span>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endif %}
            </div>
        </header>

        {% if has_stream %}
            {# Without `controls` the element renders nothing; the visible button drives it. Keeping
               the streams as <source> children leaves codec fallback to the browser, which walks
               them in order and moves on when one will not load. A single JS-assigned src cannot,
               which is why a device that chokes on the AAC mount used to sit in silence rather
               than dropping through to the MP3 behind it. #}
            <audio id="zw-fm-stream" preload="none">
                {% for source in stream_sources %}
                    <source src="{{ function('esc_url', source.url) }}" type="{{ source.type }}">
                {% endfor %}
            </audio>
        {% endif %}

        <section class="mx-auto max-w-960 px-4 pt-7" data-upcoming
                 {% if upcoming is empty %}hidden{% endif %}>
            <h2 class="mb-5 text-2xl font-bold md:text-3xl">Straks</h2>
            <div class="grid gap-4 sm:grid-cols-2" data-upcoming-list>
                {% for item in upcoming %}
                    {{ include('partial/fm-upcoming-card.twig', {
                        href: item.show.link,
                        time: item.start_time,
                        label: item.label,
                        title: item.show.title,
                        names: item.show.makers_label,
                        photo: item.show.makers|column('photo')|filter(photo => photo)|first,
                    }) }}
                {% endfor %}
            </div>
        </section>

        {# Client refreshes clone these templates to preserve the server-rendered structure. #}
        <template data-upcoming-template>
            {{ include('partial/fm-upcoming-card.twig', {
                href: '', time: '', label: '', title: '', names: '', photo: null,
            }) }}
        </template>
        <template data-portrait-template>
            {{ include('partial/fm-headshot.twig', {photo: null}) }}
        </template>

        {% if frequency_groups is not empty %}
            <section class="mx-auto max-w-960 px-4 pt-7" aria-labelledby="frequencies-title">
                <h2 id="frequencies-title" class="mb-5 text-2xl font-bold md:text-3xl">Waar je ons vindt</h2>
                {# The FM list is the longest, so it spans the left column; the rest stack on the right. #}
                <div class="grid gap-4 md:grid-cols-2 md:grid-rows-[auto_1fr] md:items-start">
                    {% for group in frequency_groups %}
                        <div class="{{ loop.first ? 'md:row-span-2 ' }}{{ card }} p-4">
                            <h3 class="mb-2 font-round text-sm font-bold tracking-wide text-gray-400 uppercase">{{ group.title }}</h3>
                            <ul>
                                {% for channel in group.channels %}
                                    <li class="flex items-baseline gap-4 border-t border-gray-800/10 py-2 dark:border-gray-200/10">
                                        {% if channel.place %}
                                            <span class="min-w-0 text-gray-600 dark:text-gray-300">{{ channel.place|e }}</span>
                                        {% endif %}
                                        <span class="ml-auto flex-none font-bold tabular-nums">{{ channel.value|e }}</span>
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                    {% endfor %}
                </div>
            </section>
        {% endif %}
    </article>
{% endblock %}
