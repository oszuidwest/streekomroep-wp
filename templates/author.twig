{% extends 'index.twig' %}

{% block content %}
    <div class="w-full mx-auto max-w-960 py-4 px-4">
        <div class="flex flex-col items-center mb-6">
            {% set avatar = author.avatar %}
            {% if avatar %}
                <img src="{{ avatar|imgproxy(96, 96)|e('html_attr') }}"
                     srcset="{{ avatar|imgproxy(96 * 2, 96 * 2)|e('html_attr') }} 2x"
                     alt="{{ author.name|e('html_attr') }}" class="h-24 w-24 rounded-sm">
            {% endif %}
            <h1 class="font-bold text-3xl my-2 text-gray-800 dark:text-white">{{ author.name|e }}</h1>
            {% if author.description %}
                <p class="text-gray-800 dark:text-white mb-2 max-w-[60ch] text-center">{{ author.description }}</p>
            {% endif %}
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {% for post in posts %}
                {{ include('partial/tile-post.twig', {post: post}) }}
            {% endfor %}
        </div>

        {{ include('partial/pagination.twig', {pagination: posts.pagination({show_all: false, mid_size: 1, end_size: 1})}) }}
    </div>
{% endblock %}
